rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write access to enrollments for public submission and admin dashboard
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // Allow public read/write access to reviews for public submission and admin dashboard
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Allow public read/write access to gallery items
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Allow public read/write access to toppers
    match /toppers/{topperId} {
      allow read, write: if true;
    }

    // Allow public read/write access to faculty
    match /faculty/{facultyId} {
      allow read, write: if true;
    }
  }
}
